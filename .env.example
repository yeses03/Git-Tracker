# Copy to `.env` (local) or set these in your host's dashboard (Vercel → Settings → Environment Variables).
# `.env` is gitignored — never commit real values.

# Postgres (Supabase / Neon / Vercel Postgres / local).
# DATABASE_URL is used at runtime — on serverless hosts use the POOLED connection string
#   (Supabase: port 6543 + `?pgbouncer=true`; Neon: the "-pooler" host).
# DIRECT_URL is used only by `prisma db push` — use the direct (non-pooled) connection.
# For a plain local Postgres, set both to the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/gittracker"
DIRECT_URL="postgresql://user:password@localhost:5432/gittracker"

# 32-byte (64 hex char) key used to AES-256-GCM encrypt player GitHub tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this makes all previously stored tokens undecryptable. Use a NEW key for production.
ENCRYPTION_KEY="replace-with-64-hex-characters"

# Password for the admin (Setup) area — required to add/remove players or change contest dates.
# Visitors without it can only view the leaderboard. Use a long random value in production.
# Changing it signs out all existing admin sessions.
ADMIN_PASSWORD="replace-with-a-long-random-password"

# Public site URL, used for link previews / canonical metadata (optional locally).
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
